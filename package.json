{
  "name": "atlas",
  "version": "0.0.0",
  "private": true,
  "description": "Atlas — open-source competitive browser Tactical RPG built on Verticality, Living Terrain, and Secret Stances.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "npm run build && npm run start --workspace @atlas/server",
    "dev:client": "npm run dev --workspace @atlas/client"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import-x": "^4.6.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.0"
  }
}
